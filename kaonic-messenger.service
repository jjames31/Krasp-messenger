[Unit]
Description=Krasp UDP Messenger
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kaonic
Group=kaonic
WorkingDirectory=/opt/kaonic-messenger
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/default/kaonic-messenger
ExecStart=/usr/bin/python3 /opt/kaonic-messenger/app.py --callsign ${KAONIC_CALLSIGN} --port ${KAONIC_PORT} --daemon --contacts /etc/kaonic-messenger/contacts.json --inbox /var/lib/kaonic-messenger/inbox.jsonl
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3
StateDirectory=kaonic-messenger
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_UNIX

[Install]
WantedBy=multi-user.target
